# ==============================================================================
# InterviewCoach AI - .gitignore
# ==============================================================================

# Node / Frontend & Backend Dependencies & Build Outputs
node_modules/
frontend/node_modules/
server/node_modules/
dist/
frontend/dist/
build/
.npm
npm-debug.log*
yarn-debug.log*
yarn-error.log*
pnpm-debug.log*
.pnpm-store

# Python Virtual Environments
venv/
.venv/
env/
ENV/
env.bak/
venv.bak/
bin/
include/
lib/
lib64/
Scripts/
pyvenv.cfg

# Python Caches & Compiled Bytecode
__pycache__/
*.py[cod]
*$py.class
*.so
.pytest_cache/
.coverage
htmlcov/
.mypy_cache/
.ruff_cache/

# Local Databases & State
*.db
*.db-journal
*.sqlite
*.sqlite3
backend/data/*.db
backend/data/*.sqlite
backend/data/*.sqlite3

# Uploaded Files & Resumes
uploads/
resumes/
server/uploads/
*.pdf
backend/data/uploads/
backend/data/resumes/

# Logs
logs/
*.log

# Environment & Secrets (Keep safe placeholder template)
.env
.env.*
!.env.example
server/.env
server/.env.*
!server/.env.example

# IDE & Editor Files
.vscode/
.idea/
*.swp
*.swo
*~
*.sublime-project
*.sublime-workspace

# Operating System & Temporary Files
.DS_Store
Thumbs.db
desktop.ini
$RECYCLE.BIN/
nul*

# Debug Scratch Files
debug_*.bat
