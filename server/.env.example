# Server Configuration
PORT=5000
NODE_ENV=development

# Database Configuration (MongoDB Local or MongoDB Atlas URI)
# For local MongoDB: mongodb://127.0.0.1:27017/interviewcoach
# For Atlas: mongodb+srv://<username>:<password>@cluster0.mongodb.net/interviewcoach?retryWrites=true&w=majority
MONGODB_URI=mongodb://127.0.0.1:27017/interviewcoach

# Authentication & Security
JWT_SECRET=your_jwt_secret_key_minimum_32_characters_here
JWT_EXPIRES_IN=7d

# AI Inference Configuration
# Options: 'practice' (offline curated bank, 0 LLM RAM), 'ollama' (local Ollama), 'cloud' (OpenAI-compatible / Gemini)
AI_PROVIDER=practice
OLLAMA_ENDPOINT=http://127.0.0.1:11434/v1
OLLAMA_MODEL=llama3:8b

# Cloud AI Configuration (Optional - only used if AI_PROVIDER=cloud or Gemini)
CLOUD_API_ENDPOINT=https://api.openai.com/v1
CLOUD_API_KEY=
CLOUD_MODEL=gpt-4o-mini

# Google Gemini API (Optional - used for live answer evaluation & resume suggestions)
GEMINI_API_KEY=
GEMINI_MODEL=gemini-1.5-flash

# Allowed CORS Origins
CORS_ORIGIN=http://127.0.0.1:5173,http://localhost:5173,http://127.0.0.1:5500,http://localhost:5500,http://127.0.0.1:5000,http://localhost:5000
