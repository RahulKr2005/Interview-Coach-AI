# InterviewCoach AI - Local Environment Configuration Example
# Copy this file to .env if you wish to override default port or inference server settings.

# Backend Server Host & Port (Strictly localhost for local privacy)
BACKEND_HOST=127.0.0.1
BACKEND_PORT=8000

# Optional Local AI Inference Server URL (e.g., Ollama or LM Studio)
# No API key required for local inference.
LOCAL_AI_ENDPOINT=http://127.0.0.1:11434/v1
LOCAL_AI_MODEL=llama3:8b
LOCAL_AI_TIMEOUT_SECONDS=20.0

# Frontend Server
FRONTEND_PORT=5173
