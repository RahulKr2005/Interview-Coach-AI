# InterviewCoach AI - Local Environment Configuration Example
# Copy this file to .env if you wish to override default port or inference server settings.

# Backend Server (MERN Stack on Port 5000)
PORT=5000
NODE_ENV=development
MONGODB_URI=mongodb://127.0.0.1:27017/interviewcoach
JWT_SECRET=super-secret-mern-jwt-key-for-interviewcoach

# Gemini AI Provider (Optional - Demo Mode used if left blank)
GEMINI_API_KEY=
GEMINI_MODEL=gemini-1.5-flash

# Frontend Server
FRONTEND_PORT=5173
